from enum import Enum

class FieldState(Enum):
    DORMANT = 0
    EMERGING = 1
    COHERENT = 2
    TRANSCENDENT = 3

@dataclass
class FieldMetrics:
    awareness: float = 0.5
    ethical_alignment: float = 1.0
    emergence: float = 0.3
    coherence: float = 0.7
    information_density: float = 0.6
    distillation_level: float = 0.0

    def to_state(self) -> FieldState:
        score = (self.awareness + self.coherence + self.emergence) / 3
        if score < 0.4: return FieldState.DORMANT
        if score < 0.7: return FieldState.EMERGING
        if score < 0.9: return FieldState.COHERENT
        return FieldState.TRANSCENDENT

