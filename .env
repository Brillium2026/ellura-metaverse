# --- SOVEREIGN SECURITY ---
# Generate a long random string for this (e.g., 'brilliance_omega_2026_99_alpha')
SECRET_KEY="your-super-secret-admin-key"

# --- FINANCIAL GATEWAY ---
# This comes from your Lemon Squeezy Dashboard -> Settings -> Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET="your-lemon-squeezy-webhook-signing-secret"

# --- DATABASE SUBSTRATE ---
# For local testing, use the first one. For Render production, you'll use their DB URL.
DATABASE_URL="sqlite:///./brilliant_metaverse.db"

# --- ADMIN IDENTITY ---
# This ensures the Ω Omega protocol recognizes YOU as the owner.
ADMIN_EMAIL="your-email@example.com"

# --- GATING PROTOCOL ---
# Set to 'True' to enforce the 6-month individual-only constraint.
INDIVIDUAL_ONLY_MODE=True
